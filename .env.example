# Server (used when running: python app.py, or platforms that inject PORT)
PORT=8000

# PostgreSQL connection (required). Local example or Railway DATABASE_URL.
DATABASE_URL=postgresql://user:password@localhost:5432/rental

# Set to 1 in production behind HTTPS so session cookies use the Secure flag
SESSION_SECURE_COOKIE=0

# Password reset email (SendGrid). If unset, only the admin manual reset flow runs.
SENDGRID_API_KEY=
SENDER_EMAIL=

# Public app URL for reset links (Railway: your live URL; local default in app.py)
BASE_URL=http://127.0.0.1:8000

# Company logos (Cloudinary). Set on Railway for persistent logos; if unset, logos save locally only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
